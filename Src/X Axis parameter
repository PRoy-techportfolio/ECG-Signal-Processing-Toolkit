def calculate_pr_reference(
    r_peaks,
    qrs_onset,
    ecg_signal,
    search_window=80,
):
    """
    Estimate a PR baseline reference before each QRS onset.

    Parameters
    ----------
    r_peaks : array-like
        Detected R-peak locations.

    qrs_onset : array-like
        QRS onset locations.

    ecg_signal : ndarray
        Filtered ECG signal.

    search_window : int
        Samples before the R-peak used for averaging.

    Returns
    -------
    reference_locations : ndarray

    pr_reference : ndarray
    """

    reference_locations = np.asarray(r_peaks) - search_window

    pr_reference = np.zeros(len(r_peaks))

    for i in range(len(r_peaks)):

        start = max(0, reference_locations[i])

        pr_reference[i] = np.mean(
            ecg_signal[start:qrs_onset[i]]
        )

    return reference_locations, pr_reference


