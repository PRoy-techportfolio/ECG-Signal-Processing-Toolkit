def detect_p_wave(ecg_signal, qrs_onset):
    """
    Detect P-wave peak and onset.

    Parameters
    ----------
    ecg_signal : ndarray
        Input ECG signal.

    qrs_onset : array-like
        Detected QRS onset locations.

    Returns
    -------
    p_locations : ndarray
        Sample indices of detected P-peaks.

    p_amplitudes : ndarray
        P-wave amplitudes.

    p_onsets : ndarray
        Sample indices of P-wave onset.
    """

    filtered_ecg = filter_p_wave(ecg_signal)

    p_locations = []
    p_amplitudes = []
    p_onsets = []

    for onset in qrs_onset:

        # ---------------------------------------------------------
        # Search Region
        # ---------------------------------------------------------
        start = max(0, onset - 250)
        end = max(start + 80, onset - 20)

        segment = filtered_ecg[start:end]

        if len(segment) < 60:

            p_locations.append(np.nan)
            p_amplitudes.append(np.nan)
            p_onsets.append(np.nan)
            continue

        # ---------------------------------------------------------
        # Peak Detection
        # ---------------------------------------------------------
        peaks, _ = signal.find_peaks(
            segment,
            prominence=0.015,
            width=8,
            distance=20,
        )

        if len(peaks) == 0:

            p_locations.append(np.nan)
            p_amplitudes.append(np.nan)
            p_onsets.append(np.nan)
            continue

        candidate_peak = peaks[-1]

        if (len(segment) - candidate_peak) < 15:

            p_locations.append(np.nan)
            p_amplitudes.append(np.nan)
            p_onsets.append(np.nan)
            continue

        # ---------------------------------------------------------
        # Baseline Estimation
        # ---------------------------------------------------------
        baseline = np.median(
            segment[
                max(0, candidate_peak - 80):
                max(1, candidate_peak - 40)
            ]
        )

        # ---------------------------------------------------------
        # Onset Detection
        # ---------------------------------------------------------
        onset_index = candidate_peak
        flat_samples = 0

        while onset_index > 5:

            slope = (
                segment[onset_index]
                - segment[onset_index - 1]
            )

            if (
                abs(slope) < 0.0015
                and abs(segment[onset_index] - baseline) < 0.01
            ):
                flat_samples += 1
            else:
                flat_samples = 0

            if flat_samples >= 4:
                break

            onset_index -= 1

        # ---------------------------------------------------------
        # Peak Refinement
        # ---------------------------------------------------------
        left = max(0, candidate_peak - 4)
        right = min(len(segment), candidate_peak + 5)

        candidate_peak = left + np.argmax(
            segment[left:right]
        )

        # ---------------------------------------------------------
        # Physiological Validation
        # ---------------------------------------------------------
        amplitude = segment[candidate_peak] - baseline
        width = candidate_peak - onset_index

        if amplitude < 0.03:
            p_locations.append(np.nan)
            p_amplitudes.append(np.nan)
            p_onsets.append(np.nan)
            continue

        if width < 10 or width > 120:
            p_locations.append(np.nan)
            p_amplitudes.append(np.nan)
            p_onsets.append(np.nan)
            continue

        # ---------------------------------------------------------
        # Save Results
        # ---------------------------------------------------------
        p_locations.append(start + candidate_peak)
        p_amplitudes.append(segment[candidate_peak])
        p_onsets.append(start + onset_index)

    return (
        np.asarray(p_locations),
        np.asarray(p_amplitudes),
        np.asarray(p_onsets),
    )
