#### QRS width measurement  ####

import numpy as np
import statistics as st


def detect_qrs_onset_offset(
    r_peaks,
    ecg_signal,
    onset_window=40,
    offset_window=50,
):
    """
    Detect the QRS onset and offset for each detected R-peak.

    Parameters
    ----------
    r_peaks : array-like
        Sample indices of detected R-peaks.

    ecg_signal : ndarray
        Filtered ECG signal.

    onset_window : int, optional
        Number of samples to search before each R-peak.

    offset_window : int, optional
        Number of samples to search after each R-peak.

    Returns
    -------
    qrs_onset : list
        Sample indices of detected QRS onset.

    qrs_offset : list
        Sample indices of detected QRS offset.
    """

    signal_length = len(ecg_signal)

    qrs_onset = []
    qrs_offset = []

    for r_peak in r_peaks:

        # ----------------------------------------------------------
        # QRS ONSET
        # ----------------------------------------------------------

        search_index = max(0, r_peak - onset_window)

        if search_index == 0:
            qrs_onset.append(0)

        else:

            previous = ecg_signal[search_index - 1]
            current = ecg_signal[search_index]

            count = 1

            while (
                current > previous
                and (search_index - count - 1) >= 0
            ):

                current = ecg_signal[search_index - count]
                previous = ecg_signal[search_index - count - 1]

                count += 1

            qrs_onset.append(max(0, search_index - count + 1))

        # ----------------------------------------------------------
        # QRS OFFSET
        # ----------------------------------------------------------

        search_index = min(
            signal_length - 1,
            r_peak + offset_window
        )

        if search_index >= signal_length - 1:

            qrs_offset.append(signal_length - 1)

        else:

            current = ecg_signal[search_index]
            next_sample = ecg_signal[search_index + 1]

            count = 1

            while (
                current < next_sample
                and (search_index + count + 1) < signal_length
            ):

                current = ecg_signal[search_index + count]
                next_sample = ecg_signal[
                    search_index + count + 1
                ]

                count += 1

            qrs_offset.append(
                min(signal_length - 1, search_index + count)
            )

    return qrs_onset, qrs_offset


