def refine_qrs_boundaries(
    r_peaks,
    ecg_signal,
    mode_value,
    onset_window=40,
    offset_window=50,
    local_window=80,
):
    """
    Refine QRS onset and offset using local signal statistics.

    Parameters
    ----------
    r_peaks : array-like
        Detected R-peak indices.

    ecg_signal : ndarray
        Filtered ECG signal.

    mode_value : float
        Global PR reference statistic.
        (Currently local median is used.)

    Returns
    -------
    refined_onset : list

    refined_offset : list
    """

    signal_length = len(ecg_signal)

    refined_onset = []
    refined_offset = []

    # ----------------------------------------------------------
    # Refine QRS Onset
    # ----------------------------------------------------------

    for r_peak in r_peaks:

        search_index = max(0, r_peak - onset_window)

        current = ecg_signal[search_index]
        previous = ecg_signal[search_index - 1]

        count = 1

        local_median = np.median(
            ecg_signal[
                max(0, search_index - local_window):
                search_index
            ]
        )

        while (
            current > previous > local_median
            and (search_index - count - 1) >= 0
        ):

            current = ecg_signal[search_index - count]
            previous = ecg_signal[
                search_index - count - 1
            ]

            count += 1

        refined_onset.append(
            max(0, search_index - count + 1)
        )

    # ----------------------------------------------------------
    # Refine QRS Offset
    # ----------------------------------------------------------

    for r_peak in r_peaks:

        search_index = min(
            signal_length - 1,
            r_peak + offset_window
        )

        current = ecg_signal[search_index]
        next_sample = ecg_signal[
            min(signal_length - 1, search_index + 1)
        ]

        count = 1

        local_median = np.median(
            ecg_signal[
                search_index:
                min(signal_length, search_index + local_window)
            ]
        )

        while (
            current < next_sample < local_median
            and (search_index + count + 1) < signal_length
        ):

            current = ecg_signal[
                search_index + count
            ]

            next_sample = ecg_signal[
                search_index + count + 1
            ]

            count += 1

        refined_offset.append(
            min(
                signal_length - 1,
                search_index + count - 1,
            )
        )

    return refined_onset, refined_offset



###### P detection #######

import numpy as np
from scipy import signal


def filter_p_wave(ecg_signal, fs=1000):
    """
    Filter an ECG signal for P-wave analysis.

    The preprocessing pipeline includes:
    - 50 Hz powerline suppression
    - Low-pass filtering
    - Savitzky-Golay smoothing
    - Median filtering for baseline estimation

    Parameters
    ----------
    ecg_signal : ndarray
        Input ECG signal.

    fs : int, optional
        Sampling frequency (Hz).

    Returns
    -------
    ndarray
        Filtered ECG signal suitable for P-wave detection.
    """

    # -------------------------------------------------------------
    # Powerline Filter Design
    # -------------------------------------------------------------
    powerline_freq = 50
    harmonic_freq = 100

    r = 1 - ((2 * np.pi) / fs)

    w0 = (2 * np.pi * powerline_freq) / fs
    w1 = (2 * np.pi * harmonic_freq) / fs

    notch_50_b = [1, -2 * np.cos(w0), 1]
    notch_50_a = [1, -2 * r * np.cos(w0), r**2]

    notch_100_b = [1, -2 * np.cos(w1), 1]
    notch_100_a = [1, -2 * r * np.cos(w1), r**2]

    # -------------------------------------------------------------
    # Filtering
    # -------------------------------------------------------------
    filtered = signal.lfilter(notch_50_b, notch_50_a, ecg_signal)
    filtered = signal.lfilter(notch_100_b, notch_100_a, filtered)

    b_lp, a_lp = signal.butter(
        4,
        40,
        fs=fs,
        btype="low"
    )

    filtered = signal.lfilter(b_lp, a_lp, filtered)

    # -------------------------------------------------------------
    # Signal Smoothing
    # -------------------------------------------------------------
    filtered = signal.savgol_filter(
        filtered,
        window_length=19,
        polyorder=3,
    )

    filtered = signal.medfilt(
        filtered,
        kernel_size=41,
    )

    return filtered


