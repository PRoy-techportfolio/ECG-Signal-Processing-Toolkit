##### Signal to Noise ratio calculation #####


import numpy as np


def calculate_snr(raw_signal, filtered_signal):
    """
    Calculate the Signal-to-Noise Ratio (SNR) in decibels.

    Noise is estimated as the difference between the raw ECG
    and the filtered ECG.

    Parameters
    ----------
    raw_signal : ndarray
        Original ECG signal.

    filtered_signal : ndarray
        Filtered ECG signal.

    Returns
    -------
    float
        Signal-to-Noise Ratio (dB).
    """

    raw_signal = np.asarray(raw_signal, dtype=float)
    filtered_signal = np.asarray(filtered_signal, dtype=float)

    # -------------------------------------------------------------
    # Estimate Noise
    # -------------------------------------------------------------
    noise = raw_signal - filtered_signal

    # -------------------------------------------------------------
    # Compute Signal and Noise Power
    # -------------------------------------------------------------
    signal_power = np.mean(filtered_signal ** 2)
    noise_power = np.mean(noise ** 2)

    # -------------------------------------------------------------
    # Avoid Division by Zero
    # -------------------------------------------------------------
    noise_power = max(noise_power, 1e-20)

    # -------------------------------------------------------------
    # Signal-to-Noise Ratio
    # -------------------------------------------------------------
    snr_db = 10 * np.log10(signal_power / noise_power)

    return snr_db
